# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Source code
*.java text diff=java eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf

# Binary files
*.jar binary
*.war binary
*.class binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary

# Export ignore for archive generation
.gitattributes export-ignore
.gitignore export-ignore
.editorconfig export-ignore
.github export-ignore
