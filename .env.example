# ==========================================
# SwiftCart Backend Environment Configuration
# ==========================================

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (MySQL / TiDB)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/swiftcart?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=password
JPA_DDL_AUTO=update

# Redis Caching & Session
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SPRING_CACHE_TYPE=redis

# Elasticsearch (Optional)
ELASTICSEARCH_ENABLED=false
ES_HOST=localhost
ES_PORT=9200

# Apache Kafka (Optional)
SPRING_KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=swiftcart-group

# JWT Security
JWT_SECRET=dGhpcy1pcy1hLXN1cGVyLXNlY3JldC1rZXktZm9yLXN3aWZ0Y2FydC1iYWNrZW5kLXByb2plY3Qtc2hvdWxkLWJlLWF0LWxlYXN0LTUxMi1iaXRzLWxvbmc=

# Frontend & OAuth2 Redirection
FRONTEND_URL=http://localhost:5173
OAUTH2_REDIRECT_URIS=http://localhost:5173/oauth2/callback

# Google OAuth2 Login
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH2_CALLBACK_URL={baseUrl}/oauth2/callback/{registrationId}

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_yourkeyid
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Brevo / SMTP Email Service
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_email_user
MAIL_PASSWORD=your_smtp_key

# Twilio SMS Notifications
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=your_twilio_phone

# AWS S3 Storage (Optional - falls back to local storage)
S3_BUCKET=swiftcart-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Spring AI & RAG Chatbot
AI_RAG_ENABLED=true
AI_RAG_TOP_K=5
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com

# Sentiment Analysis & Vendor Risk Monitoring
VENDOR_RISK_NEGATIVE_THRESHOLD=0.25
VENDOR_MIN_REVIEWS_FOR_RISK=3
